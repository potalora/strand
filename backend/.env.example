# Validated strict-local AI remains off until an immutable candidate pack has
# passed runtime and fixture validation.
LOCAL_AI_ENABLED=false
# Installed, verified model packs. Keep separate from uploads and job scratch.
LOCAL_AI_MODEL_DIR=./data/local-ai/models
# Ephemeral per-job inputs and outputs; the application cleans this directory.
LOCAL_AI_SCRATCH_DIR=./data/local-ai/scratch
# Active validated lock. The shipped candidate catalog does not activate models.
LOCAL_AI_MANIFEST_PATH=./app/model_manifests/apple-m4-16gb-v1.lock.json
# Isolated MLX worker executable; it is not installed in the backend environment.
LOCAL_AI_WORKER_COMMAND=../workers/local_ai/apple_mlx/.venv/bin/local-ai-mlx-worker
# Maximum files accepted across one model pack.
LOCAL_AI_MAX_FILES=64
# Maximum bytes accepted for one model artifact file (8 GiB).
LOCAL_AI_MAX_FILE_BYTES=8589934592
# Maximum aggregate bytes accepted for one model pack (20 GiB).
LOCAL_AI_MAX_PACK_BYTES=21474836480
# Hard deadline for one isolated worker request.
LOCAL_AI_WORKER_TIMEOUT_SECONDS=900
# Reject a rasterized page above this decoded pixel count.
LOCAL_AI_MAX_PAGE_PIXELS=40000000
