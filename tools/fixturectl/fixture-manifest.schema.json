{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medtimeline.example.invalid/schemas/fixture-manifest-v1.json",
  "title": "MedTimeline private fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "created_at",
    "hash_algorithm",
    "file_count",
    "total_bytes",
    "files"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "hash_algorithm": {"const": "sha256"},
    "file_count": {"type": "integer", "minimum": 0},
    "total_bytes": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "mode", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
          },
          "size": {"type": "integer", "minimum": 0},
          "mode": {"const": "0600"},
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
